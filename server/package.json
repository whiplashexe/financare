{
  "name": "financare-server",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "^1.4.4"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/tests",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "bun test --timeout 30000"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "cors": "^2.8.6",
    "drizzle-kit": "^1.0.0-rc.5",
    "drizzle-orm": "^1.0.0-rc.5",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "typescript": "^5.9.3",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  }
}
